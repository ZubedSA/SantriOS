# =============================================================
# Variabel Lingkungan SantriOS (SantriOS Environment Variables)
# =============================================================

# Koneksi Database Neon PostgreSQL
# URL koneksi pooled untuk query aplikasi reguler
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/santrios?sslmode=require"

# URL koneksi direct tanpa pooling (wajib untuk migrasi skema Prisma)
DIRECT_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/santrios?sslmode=require"

# Kunci Rahasia Otentikasi Sesi (JWT Session Secret)
# Minimal 32 karakter — ganti dengan string acak aman di production
AUTH_SECRET="kunci-rahasia-otentikasi-santrios-minimal-32-karakter-keamanan-tinggi"

# URL Utama Aplikasi Web
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mode Lingkungan Node (development / production / test)
NODE_ENV="development"
